package web

templ landing() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<link rel="stylesheet" type="text/css" href="/static/css/app.css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"/>
		</head>
		<body class="min-h-screen bg-[#0a0a1a] text-white overflow-hidden">
			<!-- Animated Background -->
			<div class="fixed inset-0 z-0">
				<div class="absolute inset-0 bg-gradient-to-br from-purple-900/30 via-[#0a0a1a] to-pink-900/30"></div>
				<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl animate-pulse"></div>
				<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-pink-500/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-purple-600/10 rounded-full blur-[100px]"></div>
			</div>

			<!-- Floating Music Icons -->
			<div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
				<i class="bi bi-music-note absolute text-purple-400/20 text-4xl animate-float" style="top: 20%; left: 10%; animation-delay: 0s;"></i>
				<i class="bi bi-music-note-beamed absolute text-pink-400/20 text-3xl animate-float" style="top: 60%; left: 85%; animation-delay: 2s;"></i>
				<i class="bi bi-disc absolute text-purple-400/20 text-5xl animate-float" style="top: 80%; left: 15%; animation-delay: 4s;"></i>
				<i class="bi bi-music-player absolute text-pink-400/20 text-4xl animate-float" style="top: 15%; left: 70%; animation-delay: 1s;"></i>
			</div>

			<!-- Main Content -->
			<div class="relative z-10 min-h-screen flex flex-col items-center justify-center px-4">
				<!-- Logo & Title -->
				<div class="text-center mb-12">
					<div class="flex items-center justify-center gap-2 mb-6">
						<div class="flex gap-1 h-8 items-end">
							<div class="w-2 rounded-full bg-gradient-to-t from-purple-500 to-pink-500 animate-[viz_1.2s_ease-in-out_infinite]"></div>
							<div class="w-2 rounded-full bg-gradient-to-t from-purple-500 to-pink-500 animate-[viz_0.9s_ease-in-out_infinite]"></div>
							<div class="w-2 rounded-full bg-gradient-to-t from-purple-500 to-pink-500 animate-[viz_0.7s_ease-in-out_infinite]"></div>
							<div class="w-2 rounded-full bg-gradient-to-t from-purple-500 to-pink-500 animate-[viz_0.9s_ease-in-out_infinite]"></div>
							<div class="w-2 rounded-full bg-gradient-to-t from-purple-500 to-pink-500 animate-[viz_1.2s_ease-in-out_infinite]"></div>
						</div>
						<h1 class="text-6xl font-extrabold tracking-tight bg-gradient-to-r from-purple-400 via-pink-400 to-purple-400 bg-clip-text text-transparent">
							Raver
						</h1>
					</div>
					<p class="text-xl text-white/60 max-w-md mx-auto">
						Your ultimate Discord music companion
					</p>
				</div>

				<!-- Feature Cards -->
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mb-12">
					<div class="group p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 hover:border-purple-500/30 transition-all duration-300">
						<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500/20 to-pink-500/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
							<i class="bi bi-search text-purple-400 text-xl"></i>
						</div>
						<h3 class="text-lg font-semibold mb-2">Search & Play</h3>
						<p class="text-sm text-white/50">Find and play your favorite tracks from YouTube instantly</p>
					</div>
					<div class="group p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 hover:border-pink-500/30 transition-all duration-300">
						<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-pink-500/20 to-purple-500/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
							<i class="bi bi-collection-play text-pink-400 text-xl"></i>
						</div>
						<h3 class="text-lg font-semibold mb-2">Queue System</h3>
						<p class="text-sm text-white/50">Build the perfect playlist with easy queue management</p>
					</div>
					<div class="group p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm hover:bg-white/10 hover:border-purple-500/30 transition-all duration-300">
						<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500/20 to-pink-500/20 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
							<i class="bi bi-people text-purple-400 text-xl"></i>
						</div>
						<h3 class="text-lg font-semibold mb-2">Server Control</h3>
						<p class="text-sm text-white/50">Manage music across all your Discord servers</p>
					</div>
				</div>

				<!-- CTA Button -->
				<a
					href="/auth/login"
					class="group relative inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold text-lg overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-[0_0_40px_-10px_rgba(168,85,247,0.5)]"
				>
					<i class="bi bi-discord text-xl"></i>
					<span>Login with Discord</span>
					<i class="bi bi-arrow-right transition-transform group-hover:translate-x-1"></i>
				</a>

				<!-- Footer -->
				<p class="mt-12 text-white/30 text-sm">
					Powered by <span class="text-purple-400">Discord</span> & <span class="text-pink-400">YouTube</span>
				</p>
			</div>

			<style>
				@keyframes viz {
					0%, 100% { height: 20%; }
					50% { height: 100%; }
				}
				@keyframes float {
					0%, 100% { transform: translateY(0) rotate(0deg); }
					50% { transform: translateY(-20px) rotate(10deg); }
				}
				.animate-float {
					animation: float 6s ease-in-out infinite;
				}
			</style>
		</body>
	</html>
}
